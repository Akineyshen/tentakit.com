---
// Знак Tentakit: круг и 8 щупалец вихрем — тот же, что в иконке приложения.
// tile = true: белый знак на фиолетово-розовой плитке (как иконка приложения).
interface Props { size?: number; tile?: boolean; class?: string }
const { size = 40, tile = false, class: cls } = Astro.props;
---
{tile ? (
  <span class:list={['octo-tile', cls]} style={`width:${size}px;height:${size}px;border-radius:${size * 0.225}px`}>
    <svg width={size * 0.74} height={size * 0.74} viewBox="-256 -256 512 512" aria-hidden="true" style="color:#fff">
  <circle r="62" fill="currentColor"/>
  <path transform="rotate(0)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
  <path transform="rotate(45)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
  <path transform="rotate(90)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
  <path transform="rotate(135)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
  <path transform="rotate(180)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
  <path transform="rotate(225)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
  <path transform="rotate(270)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
  <path transform="rotate(315)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
    </svg>
  </span>
) : (
  <svg class={cls} width={size} height={size} viewBox="-256 -256 512 512" aria-hidden="true">
  <circle r="62" fill="currentColor"/>
  <path transform="rotate(0)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
  <path transform="rotate(45)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
  <path transform="rotate(90)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
  <path transform="rotate(135)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
  <path transform="rotate(180)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
  <path transform="rotate(225)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
  <path transform="rotate(270)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
  <path transform="rotate(315)" d="M 0 -96 C 46 -138 46 -196 0 -212 C -30 -222 -46 -194 -26 -182" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round"/>
  </svg>
)}

<style>
  .octo-tile { display: inline-grid; place-items: center; flex: none;
    background: linear-gradient(135deg, #8e5cf7, #f0508f); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .18), 0 1px 3px rgb(142 92 247 / .35); }
</style>
